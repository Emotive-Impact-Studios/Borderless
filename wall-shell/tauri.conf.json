{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Borderless Wall",
  "version": "0.1.0",
  "identifier": "studio.emotive.borderless.wall",
  "build": { "frontendDist": "./frontend" },
  "app": {
    "windows": [{ "label": "wall", "title": "Borderless Wall", "url": "index.html", "resizable": true }],
    "security": { "capabilities": [], "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; object-src 'none'; base-uri 'none'; form-action 'none'" }
  },
  "bundle": { "active": false, "icon": ["../desktop/assets/icon.png"] }
}
