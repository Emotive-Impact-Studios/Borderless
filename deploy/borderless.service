[Unit]
Description=Borderless local room hub
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=borderless
Group=borderless
WorkingDirectory=/opt/borderless
ExecStart=/usr/bin/node /opt/borderless/server/index.mjs
Environment=BORDERLESS_HOST=0.0.0.0
Environment=BORDERLESS_PORT=8443
Environment=BORDERLESS_DATA=/var/lib/borderless
Environment=BORDERLESS_PUBLIC_URL=https://room-hub.example:8443
Environment=BORDERLESS_TLS_CERT=/etc/borderless/cert.pem
Environment=BORDERLESS_TLS_KEY=/etc/borderless/key.pem
StateDirectory=borderless
UMask=0077
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/borderless
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
