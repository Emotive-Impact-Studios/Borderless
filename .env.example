# Set in your shell or service configuration. No credentials belong in this file.
BORDERLESS_HOST=127.0.0.1
BORDERLESS_PORT=8443
BORDERLESS_DATA=.borderless
# LAN access requires TLS. Generate a SAN certificate with npm run cert -- <LAN IP>.
# BORDERLESS_HOST=0.0.0.0
# BORDERLESS_PUBLIC_URL=https://192.168.1.10:8443
# BORDERLESS_TLS_CERT=certs/cert.pem
# BORDERLESS_TLS_KEY=certs/key.pem
# BORDERLESS_MDNS=1
# Managed live media. For a multi-machine room, see docs/OPERATIONS.md.
# BORDERLESS_MEDIA=1
# BORDERLESS_MEDIA_SIGNAL_URL=wss://room-hub.local:7443
# BORDERLESS_MEDIA_RTC_ADDRESS=192.168.1.10
