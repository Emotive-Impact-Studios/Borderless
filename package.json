{
  "name": "borderless",
  "version": "0.1.0",
  "private": true,
  "main": "desktop/main.mjs",
  "license": "UNLICENSED",
  "author": "Emotive Impact Studios",
  "description": "A shared canvas for every screen in the room.",
  "type": "module",
  "workspaces": ["web"],
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "volta": {
    "node": "24.22.1"
  },
  "scripts": {
    "start": "node server/index.mjs",
    "dev": "node --watch server/index.mjs",
    "test": "node scripts/run-tests.mjs",
    "check": "node scripts/check.mjs",
    "build": "npm run build --workspace=borderless-web && node scripts/prepare-wall-shell.mjs && node scripts/build.mjs",
    "verify": "npm run check && npm run build && npm test",
    "native:verify": "node scripts/verify-native.mjs",
    "native:mac:package": "node scripts/package-native-mac.mjs",
    "cert": "node scripts/cert.mjs",
    "audit:verify": "node scripts/audit.mjs",
    "backup": "node scripts/backup.mjs",
    "restore": "node scripts/restore.mjs",
    "desktop": "npm --prefix desktop start",
    "desktop:install": "npm --prefix desktop ci",
    "desktop:smoke": "npm --prefix desktop run smoke",
    "release:verify": "node scripts/verify-release.mjs"
  },
  "dependencies": {
    "bonjour-service": "1.4.4",
    "livekit-server-sdk": "2.19.2",
    "qrcode": "1.5.4",
    "ws": "8.22.1"
  }
}
