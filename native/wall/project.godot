config_version=5

[application]
config/name="Borderless Wall"
run/main_scene="res://Wall.tscn"
config/features=PackedStringArray("4.7", "C#", "GL Compatibility")

[display]
window/size/viewport_width=1280
window/size/viewport_height=800
window/stretch/mode="canvas_items"

[dotnet]
project/assembly_name="Borderless.Wall"

[rendering]
renderer/rendering_method="gl_compatibility"
environment/defaults/default_clear_color=Color(0.97, 0.97, 0.96, 1)
